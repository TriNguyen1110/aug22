{
  "name": "hacker-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "tsx src/db/migrate.ts",
    "ingest:reddit": "tsx src/ingest/reddit.ts",
    "detect": "tsx src/detect/run.ts",
    "seed": "node tools/seed.mjs",
    "seed:bad": "node tools/seed.mjs --with-bad",
    "smoke": "node tools/smoke.mjs",
    "smoke:db": "node tools/smoke.mjs --skip-api",
    "cite": "node tools/cite-check.mjs",
    "cite:urls": "node tools/cite-check.mjs --urls",
    "shot": "node tools/screenshot.mjs",
    "weblogs": "node tools/weblogs.mjs",
    "test:backend": "node --test tests/backend.flows.test.mjs",
    "test:frontend": "node --test tests/frontend.flows.test.mjs",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "better-sqlite3": "^11.10.0",
    "playwright": "^1.49.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@heroui/react": "^2.8.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.462.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  }
}
